# ═══════════════════════════════════════════════════════════════
# ServerWatch — Cấu hình mẫu (.env.example)
# Copy file này thành .env và điền giá trị thật:
#   cp .env.example .env
# ═══════════════════════════════════════════════════════════════

# ── Bảo mật ────────────────────────────────────────────────────
# Token xác thực giữa agent và server.
# Sinh chuỗi ngẫu nhiên 64 ký tự: openssl rand -hex 32
SECRET_TOKEN=change-me-to-a-random-64-char-string

# ── Tài khoản Admin Dashboard ──────────────────────────────────
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change-me-to-a-strong-password
# JWT_SECRET: nếu để trống sẽ dùng lại SECRET_TOKEN.
# Khuyến nghị sinh chuỗi riêng: openssl rand -hex 32
JWT_SECRET=
JWT_EXPIRE_HOURS=24

# ── CORS (domain được phép truy cập API) ──────────────────────
ALLOWED_ORIGINS=https://monitor.example.com

# ── Nginx ──────────────────────────────────────────────────────
# Port internal nginx (chỉ bind 127.0.0.1)
NGINX_PORT=8800

# ── Telegram Bot ────────────────────────────────────────────────
# Tạo bot: chat với @BotFather → /newbot
TELEGRAM_BOT_TOKEN=0000000000:AAAA-your-bot-token-here
# ID Telegram chat nhận cảnh báo (lấy từ @userinfobot, group thì có dấu trừ ở đầu)
TELEGRAM_CHAT_ID=123456789
TELEGRAM_ADMIN_IDS=123456789

# ── Email (SMTP) ────────────────────────────────────────────────
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=serverwatch@example.com
SMTP_PASS=your-smtp-app-password
ALERT_EMAIL=admin@example.com

# ── Docker Monitoring ──────────────────────────────────────────
# Bật/tắt Docker monitoring (mặc định: tự động phát hiện)
DOCKER_MONITORING=auto
# Số dòng log tối đa lấy mỗi chu kỳ
DOCKER_LOG_TAIL=100
# Ngưỡng restart count để cảnh báo
DOCKER_RESTART_THRESHOLD=3

# ── AI Engine (tùy chọn) ───────────────────────────────────────
# Backend: "claude" (Anthropic API) hoặc "ollama" (local, miễn phí)
AI_BACKEND=ollama
# Bật/tắt AI analysis
AI_ENABLED=true
# Bật auto-fix (AI đề xuất lệnh, admin phê duyệt qua Telegram)
AI_AUTO_FIX=false

# ── Claude API (nếu AI_BACKEND=claude) ─────────────────────────
# Lấy API key tại: https://console.anthropic.com
ANTHROPIC_API_KEY=
AI_MODEL=claude-sonnet-4-20250514

# ── Ollama (nếu AI_BACKEND=ollama) ─────────────────────────────
# Cài Ollama: https://ollama.com/download
# Pull model:  ollama pull gemma3:27b
OLLAMA_URL=http://host.docker.internal:11434
OLLAMA_MODEL=gemma3:27b
OLLAMA_TIMEOUT=120

# ── ServerWatch API (dùng cho Telegram Bot) ────────────────────
SERVERWATCH_API=http://server:8000
SERVERWATCH_TOKEN=change-me-to-a-random-64-char-string
