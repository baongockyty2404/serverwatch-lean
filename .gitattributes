# Force LF line endings cho file chạy trên Linux server / Docker
# (tránh shebang shell script bị fail khi clone trên Windows)

*.sh        text eol=lf
*.service   text eol=lf
*.conf      text eol=lf
Dockerfile  text eol=lf
*.yml       text eol=lf
*.yaml      text eol=lf

# Python: LF cross-platform standard
*.py        text eol=lf

# Docs: cho phép CRLF trên Windows (đỡ phiền editor)
*.md        text
*.txt       text

# Binary
*.png       binary
*.jpg       binary
*.gif       binary
*.zip       binary
